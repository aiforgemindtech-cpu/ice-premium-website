# Copy to .env.local for local development, and set the same values as
# encrypted secrets in the Cloudflare dashboard for production.
# .env.local is gitignored — never commit real keys.

# Transactional email for the contact form (https://resend.com — free tier: 3,000/mo).
# Without this the form still works and still shows success; the enquiry is
# logged server-side rather than emailed.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form enquiries are delivered.
# Defaults to contact.email in content/site.config.json if unset.
CONTACT_TO_EMAIL=info@icepremiumltd.com

# Verified sender address. Until you verify a domain in Resend, leave this as
# the Resend test sender below.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Image generation (Google AI Studio — free key at aistudio.google.com).
# Only needed to run `npm run images:ai`, which generates the site photography.
# Not required to build or run the site.
GEMINI_API_KEY=
